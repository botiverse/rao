{
  "name": "rao",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop client that launches and drives coding agents (Claude Code, Codex, Kimi Code, Pi, Grok) through one interface.",
  "license": "Apache-2.0",
  "author": "xxchan",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "run-p typecheck:node typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "run-s typecheck lint format:check test test:preload",
    "fix": "run-s 'lint -- --fix' format",
    "package": "electron-vite build && node scripts/package.mjs --dir",
    "package:mac": "electron-vite build && node scripts/package.mjs --mac",
    "test:preload": "electron-vite build && node scripts/check-preload.mjs",
    "test:app": "node scripts/check-app.mjs"
  },
  "dependencies": {
    "@botiverse/oar": "^0.6.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "productName": "Rao"
}
